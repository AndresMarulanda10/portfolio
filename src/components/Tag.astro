---
export interface Props {
  text: string;
  href?: string;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { text, href, size = 'md', class: className, ...rest } = Astro.props as Props;

const sizes: Record<NonNullable<Props['size']>, string> = {
  sm: 'text-xs px-3 py-1',
  md: 'text-sm px-4 py-1.5',
  lg: 'text-base px-5 py-2',
};

const base =
  'inline-flex items-center justify-center rounded-full border-2 bg-transparent ' +
  'border-white text-white uppercase tracking-wide select-none';
---

{href ? (
  <a
    class={`${base} ${sizes[size]} ${className ?? ''} focus:outline-none focus-visible:ring-2 focus-visible:ring-white/60`}
    href={href}
    {...rest}
  >
    {text}
  </a>
) : (
  <span
    class={`${base} ${sizes[size]} ${className ?? ''}`}
    {...rest}
  >
    {text}
  </span>
)}
